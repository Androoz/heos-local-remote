{
  "sourceLanguage" : "sv",
  "strings" : {
    "Ange adressen till valfri HEOS-spelare på nätverket. Appen hämtar hela HEOS-systemet via den enheten." : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Enter the address of any HEOS player on the network. The app retrieves the entire HEOS system through that player." } }, "sv" : { "stringUnit" : { "state" : "translated", "value" : "Ange adressen till valfri HEOS-spelare på nätverket. Appen hämtar hela HEOS-systemet via den enheten." } } } },
    "Ange en giltig IP-adress eller ett lokalt värdnamn." : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Enter a valid IP address or local host name." } }, "sv" : { "stringUnit" : { "state" : "translated", "value" : "Ange en giltig IP-adress eller ett lokalt värdnamn." } } } },
    "Anslut" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Connect" } }, "sv" : { "stringUnit" : { "state" : "translated", "value" : "Anslut" } } } },
    "Anslut till HEOS" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Connect to HEOS" } }, "sv" : { "stringUnit" : { "state" : "translated", "value" : "Anslut till HEOS" } } } },
    "Anslut till sparad adress" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Connect to saved address" } }, "sv" : { "stringUnit" : { "state" : "translated", "value" : "Anslut till sparad adress" } } } },
    "Ansluten" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Connected" } }, "sv" : { "stringUnit" : { "state" : "translated", "value" : "Ansluten" } } } },
    "Ansluten via" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Connected through" } }, "sv" : { "stringUnit" : { "state" : "translated", "value" : "Ansluten via" } } } },
    "Ansluter till HEOS…" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Connecting to HEOS…" } }, "sv" : { "stringUnit" : { "state" : "translated", "value" : "Ansluter till HEOS…" } } } },
    "Ansluter…" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Connecting…" } }, "sv" : { "stringUnit" : { "state" : "translated", "value" : "Ansluter…" } } } },
    "Anslutningen misslyckades" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Connection failed" } }, "sv" : { "stringUnit" : { "state" : "translated", "value" : "Anslutningen misslyckades" } } } },
    "Automatisk HEOS-sökning saknar multicast-behörighet. Ange en adress manuellt eller kontrollera appens signering." : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Automatic HEOS discovery does not have multicast permission. Enter an address manually or check the app signing." } }, "sv" : { "stringUnit" : { "state" : "translated", "value" : "Automatisk HEOS-sökning saknar multicast-behörighet. Ange en adress manuellt eller kontrollera appens signering." } } } },
    "Avbryt" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Cancel" } }, "sv" : { "stringUnit" : { "state" : "translated", "value" : "Avbryt" } } } },
    "Bluetooth" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Bluetooth" } }, "sv" : { "stringUnit" : { "state" : "translated", "value" : "Bluetooth" } } } },
    "Byt HEOS-adress…" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Change HEOS address…" } }, "sv" : { "stringUnit" : { "state" : "translated", "value" : "Byt HEOS-adress…" } } } },
    "Dela grupp" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Ungroup" } }, "sv" : { "stringUnit" : { "state" : "translated", "value" : "Dela grupp" } } } },
    "Extern ingång" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "External input" } }, "sv" : { "stringUnit" : { "state" : "translated", "value" : "Extern ingång" } } } },
    "Föregående" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Previous" } }, "sv" : { "stringUnit" : { "state" : "translated", "value" : "Föregående" } } } },
    "Hantera grupp" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Manage group" } }, "sv" : { "stringUnit" : { "state" : "translated", "value" : "Hantera grupp" } } } },
    "HEOS-adress" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "HEOS address" } }, "sv" : { "stringUnit" : { "state" : "translated", "value" : "HEOS-adress" } } } },
    "HEOS-controller" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "HEOS controller" } }, "sv" : { "stringUnit" : { "state" : "translated", "value" : "HEOS-controller" } } } },
    "HEOS-enheten svarade men rapporterade inga tillgängliga spelare." : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "The HEOS device responded but reported no available players." } }, "sv" : { "stringUnit" : { "state" : "translated", "value" : "HEOS-enheten svarade men rapporterade inga tillgängliga spelare." } } } },
    "HEOS-grupp" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "HEOS group" } }, "sv" : { "stringUnit" : { "state" : "translated", "value" : "HEOS-grupp" } } } },
    "HEOS-spelare" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "HEOS player" } }, "sv" : { "stringUnit" : { "state" : "translated", "value" : "HEOS-spelare" } } } },
    "Hämtar HEOS-spelare…" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Loading HEOS players…" } }, "sv" : { "stringUnit" : { "state" : "translated", "value" : "Hämtar HEOS-spelare…" } } } },
    "Inga HEOS-spelare hittades" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "No HEOS players found" } }, "sv" : { "stringUnit" : { "state" : "translated", "value" : "Inga HEOS-spelare hittades" } } } },
    "Inget spelas" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Nothing playing" } }, "sv" : { "stringUnit" : { "state" : "translated", "value" : "Inget spelas" } } } },
    "Klar" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Done" } }, "sv" : { "stringUnit" : { "state" : "translated", "value" : "Klar" } } } },
    "Kontrollera att spelarna är påslagna och uppdatera listan." : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Make sure the players are turned on and refresh the list." } }, "sv" : { "stringUnit" : { "state" : "translated", "value" : "Kontrollera att spelarna är påslagna och uppdatera listan." } } } },
    "Koppla från" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Disconnect" } }, "sv" : { "stringUnit" : { "state" : "translated", "value" : "Koppla från" } } } },
    "Kunde inte söka efter HEOS-enheter på nätverket." : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Could not search for HEOS devices on the network." } }, "sv" : { "stringUnit" : { "state" : "translated", "value" : "Kunde inte söka efter HEOS-enheter på nätverket." } } } },
    "Ljudet är avstängt" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Muted" } }, "sv" : { "stringUnit" : { "state" : "translated", "value" : "Ljudet är avstängt" } } } },
    "Lokal fjärrkontroll utan konto eller moln" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Local remote control without an account or cloud" } }, "sv" : { "stringUnit" : { "state" : "translated", "value" : "Lokal fjärrkontroll utan konto eller moln" } } } },
    "Musik" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Music" } }, "sv" : { "stringUnit" : { "state" : "translated", "value" : "Musik" } } } },
    "Namnlös HEOS-spelare" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Unnamed HEOS player" } }, "sv" : { "stringUnit" : { "state" : "translated", "value" : "Namnlös HEOS-spelare" } } } },
    "Nästa" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Next" } }, "sv" : { "stringUnit" : { "state" : "translated", "value" : "Nästa" } } } },
    "Okänd källa" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Unknown source" } }, "sv" : { "stringUnit" : { "state" : "translated", "value" : "Okänd källa" } } } },
    "Pausa" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Pause" } }, "sv" : { "stringUnit" : { "state" : "translated", "value" : "Pausa" } } } },
    "Radio" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Radio" } }, "sv" : { "stringUnit" : { "state" : "translated", "value" : "Radio" } } } },
