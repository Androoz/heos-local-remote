    "Samma volym i alla rum" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Same volume in every room" } }, "sv" : { "stringUnit" : { "state" : "translated", "value" : "Samma volym i alla rum" } } } },
    "Spela" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Play" } }, "sv" : { "stringUnit" : { "state" : "translated", "value" : "Spela" } } } },
    "Spela även i…" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Play in other rooms…" } }, "sv" : { "stringUnit" : { "state" : "translated", "value" : "Spela även i…" } } } },
    "Spelar gruppens ljud" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Plays the group's audio" } }, "sv" : { "stringUnit" : { "state" : "translated", "value" : "Spelar gruppens ljud" } } } },
    "Stoppa och gruppera" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Stop and group" } }, "sv" : { "stringUnit" : { "state" : "translated", "value" : "Stoppa och gruppera" } } } },
    "Stoppa TV-/externljud?" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Stop TV/external audio?" } }, "sv" : { "stringUnit" : { "state" : "translated", "value" : "Stoppa TV-/externljud?" } } } },
    "Stäng" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Close" } }, "sv" : { "stringUnit" : { "state" : "translated", "value" : "Stäng" } } } },
    "Stäng av ljud" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Mute" } }, "sv" : { "stringUnit" : { "state" : "translated", "value" : "Stäng av ljud" } } } },
    "Sök efter HEOS-enheter" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Search for HEOS devices" } }, "sv" : { "stringUnit" : { "state" : "translated", "value" : "Sök efter HEOS-enheter" } } } },
    "Söker automatiskt efter HEOS-spelare på ditt lokala nätverk. Du kan alltid ansluta manuellt nedan." : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Automatically searching for HEOS players on your local network. You can always connect manually below." } }, "sv" : { "stringUnit" : { "state" : "translated", "value" : "Söker automatiskt efter HEOS-spelare på ditt lokala nätverk. Du kan alltid ansluta manuellt nedan." } } } },
    "Söker efter HEOS…" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Searching for HEOS…" } }, "sv" : { "stringUnit" : { "state" : "translated", "value" : "Söker efter HEOS…" } } } },
    "Slå på ljud" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Unmute" } }, "sv" : { "stringUnit" : { "state" : "translated", "value" : "Slå på ljud" } } } },
    "TV-ljud" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "TV audio" } }, "sv" : { "stringUnit" : { "state" : "translated", "value" : "TV-ljud" } } } },
    "Uppdatera" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Refresh" } }, "sv" : { "stringUnit" : { "state" : "translated", "value" : "Uppdatera" } } } },
    "Volym per rum" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Volume by room" } }, "sv" : { "stringUnit" : { "state" : "translated", "value" : "Volym per rum" } } } },
    "Återansluter…" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Reconnecting…" } }, "sv" : { "stringUnit" : { "state" : "translated", "value" : "Återansluter…" } } } },
    "Öppna Inställningar" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Open Settings" } }, "sv" : { "stringUnit" : { "state" : "translated", "value" : "Öppna Inställningar" } } } },
    "Frånkopplad" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Disconnected" } }, "sv" : { "stringUnit" : { "state" : "translated", "value" : "Frånkopplad" } } } },
    "Anslutningsstatus: %@" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Connection status: %@" } }, "sv" : { "stringUnit" : { "state" : "translated", "value" : "Anslutningsstatus: %@" } } } },
    "TV-/externljudet behålls och %@ blir gruppledare. ‘Gruppera TV-ljud’ måste vara aktiverat för soundbaren." : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "TV/external audio is retained and %@ becomes the group leader. ‘Group TV Audio’ must be enabled for the soundbar." } }, "sv" : { "stringUnit" : { "state" : "translated", "value" : "TV-/externljudet behålls och %@ blir gruppledare. ‘Gruppera TV-ljud’ måste vara aktiverat för soundbaren." } } } },
    "TV-/externljud i valda medlemsrum stoppas så att %@s ljud kan ta över." : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "TV/external audio in the selected member rooms is stopped so %@'s audio can take over." } }, "sv" : { "stringUnit" : { "state" : "translated", "value" : "TV-/externljud i valda medlemsrum stoppas så att %@s ljud kan ta över." } } } },
    "Spela TV-ljud även i…" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Play TV audio in…" } }, "sv" : { "stringUnit" : { "state" : "translated", "value" : "Spela TV-ljud även i…" } } } },
    "Spela %@ även i…" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Play %@ in…" } }, "sv" : { "stringUnit" : { "state" : "translated", "value" : "Spela %@ även i…" } } } },
    "För att spela %@s ljud i de valda rummen behöver appen först stoppa deras aktiva TV- eller externingång. Detta visas bara första gången." : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "To play %@'s audio in the selected rooms, the app first needs to stop their active TV or external input. This is only shown the first time." } }, "sv" : { "stringUnit" : { "state" : "translated", "value" : "För att spela %@s ljud i de valda rummen behöver appen först stoppa deras aktiva TV- eller externingång. Detta visas bara första gången." } } } },
    "Kunde inte starta HEOS-sökningen: %@" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Could not start HEOS discovery: %@" } }, "sv" : { "stringUnit" : { "state" : "translated", "value" : "Kunde inte starta HEOS-sökningen: %@" } } } },
    "Lokal nätverksåtkomst saknas. Aktivera åtkomst i Inställningar." : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Local network access is unavailable. Enable access in Settings." } }, "sv" : { "stringUnit" : { "state" : "translated", "value" : "Lokal nätverksåtkomst saknas. Aktivera åtkomst i Inställningar." } } } },
    "Anslutningen till HEOS-systemet bröts." : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "The connection to the HEOS system was lost." } }, "sv" : { "stringUnit" : { "state" : "translated", "value" : "Anslutningen till HEOS-systemet bröts." } } } },
    "HEOS-enheten svarade inte i tid. Kontrollera adressen och nätverket." : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "The HEOS device did not respond in time. Check the address and network." } }, "sv" : { "stringUnit" : { "state" : "translated", "value" : "HEOS-enheten svarade inte i tid. Kontrollera adressen och nätverket." } } } },
    "Kunde inte ansluta till HEOS-enheten. Kontrollera adressen och att enheterna är på samma nätverk." : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Could not connect to the HEOS device. Check the address and make sure the devices are on the same network." } }, "sv" : { "stringUnit" : { "state" : "translated", "value" : "Kunde inte ansluta till HEOS-enheten. Kontrollera adressen och att enheterna är på samma nätverk." } } } },
    "Ingen aktiv HEOS-anslutning." : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "No active HEOS connection." } }, "sv" : { "stringUnit" : { "state" : "translated", "value" : "Ingen aktiv HEOS-anslutning." } } } },
    "Anslutningen till HEOS-enheten tog för lång tid." : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "The connection to the HEOS device timed out." } }, "sv" : { "stringUnit" : { "state" : "translated", "value" : "Anslutningen till HEOS-enheten tog för lång tid." } } } },
    "Spelarna kan styras, men automatiska statusuppdateringar kunde inte aktiveras." : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "The players can be controlled, but automatic status updates could not be enabled." } }, "sv" : { "stringUnit" : { "state" : "translated", "value" : "Spelarna kan styras, men automatiska statusuppdateringar kunde inte aktiveras." } } } },
    "Gruppen kunde inte skapas av HEOS. Om en HomeCinema-, Bar- eller TV-enhet ingår: stoppa TV-ljudet eller aktivera ‘Gruppera TV-ljud’ i HEOS-appen och försök igen." : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "HEOS could not create the group. If it includes a HomeCinema, Bar, or TV device: stop TV audio or enable ‘Group TV Audio’ in the HEOS app and try again." } }, "sv" : { "stringUnit" : { "state" : "translated", "value" : "Gruppen kunde inte skapas av HEOS. Om en HomeCinema-, Bar- eller TV-enhet ingår: stoppa TV-ljudet eller aktivera ‘Gruppera TV-ljud’ i HEOS-appen och försök igen." } } } },
    "HEOS-kommandot misslyckades: %@" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "The HEOS command failed: %@" } }, "sv" : { "stringUnit" : { "state" : "translated", "value" : "HEOS-kommandot misslyckades: %@" } } } },
    "HEOS-enheten svarade inte i tid." : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "The HEOS device did not respond in time." } }, "sv" : { "stringUnit" : { "state" : "translated", "value" : "HEOS-enheten svarade inte i tid." } } } }
  },
  "version" : "1.0"
}
